# Required — database
ALKEMIO_DATABASE_HOST=localhost
ALKEMIO_DATABASE_PORT=5432
ALKEMIO_DATABASE_USERNAME=alkemio_file_svc
ALKEMIO_DATABASE_PASSWORD=secret
ALKEMIO_DATABASE_NAME=alkemio

# Auth transport — set ONE of these (h2c preferred if both set)
AUTH_SERVICE_URL=http://localhost:6060
# NATS_URL=nats://localhost:4222

# Circuit breaker — shared by both auth transports
AUTH_BREAKER_FAILURE_THRESHOLD=3
AUTH_BREAKER_TIMEOUT_SECONDS=15
AUTH_BREAKER_HALF_OPEN_MAX_REQUESTS=2

# Optional (defaults shown)
PORT=4003
LOCAL_STORAGE_PATH=../server/.storage
STORAGE_TYPE=local
DOCUMENT_MAX_AGE=86400

# NATS-specific (only used when NATS_URL is set)
NATS_SUBJECT=auth.evaluate
NATS_RECONNECT_WAIT_MS=1000
NATS_RECONNECT_MAX_WAIT_MS=30000
